# 이 배포가 연결할 백엔드 주소 (경로 없는 https 주소). 미리보기 배포에서는 필수 — 비면 앱이 설정 오류 화면을 보여준다.
VITE_API_URL=
# (Vercel 빌드 환경변수, VITE_ 접두사 없음) /api/admin/* 를 넘길 백엔드 주소. 미리보기에서는 VITE_API_URL 과 같은 값을 넣는다.
ADMIN_API_TARGET=
# 테스트 결제(포트원) 가맹점 코드. 미리보기에서는 필수 — 없으면 결제창을 열지 않는다. 운영 코드는 넣지 않는다.
VITE_IMP_CODE=
# (테스트 전용) 포트원 V1 테스트 채널 키. 비운영 도메인에서만 쓰이고, 운영 도메인에서는 무시된다. 같은 계정의 운영 식별코드(VITE_IMP_CODE)와 함께 쓴다.
VITE_IMP_CHANNEL_KEY=
# (테스트 전용) 이 키가 들어오면 테스트 실행을 막을 운영(실연동) 채널 키 목록(쉼표로 구분).
VITE_IMP_BLOCKED_CHANNEL_KEYS=
